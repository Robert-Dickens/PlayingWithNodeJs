API_PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=productdb
DB_USER=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_URL=amqp://guest:guest@localhost:5672

CORS_ORIGIN=*

# Telemetry / OpenTelemetry
# For standalone runs, set this to an OTLP/gRPC collector (for example, http://localhost:4317).
# Aspire injects its active OTLP endpoint, protocol, and headers automatically.
LOG_LEVEL=info

